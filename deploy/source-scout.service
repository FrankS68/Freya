[Unit]
Description=Source Scout - Quellen-Recherche und Portal-Publikation
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=freya
Group=freya
WorkingDirectory=/opt/freya
EnvironmentFile=/opt/freya/.env
ExecStart=/usr/bin/java -Xmx200m -jar /opt/freya/freya.jar
Restart=on-failure
RestartSec=30
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=yes
ReadWritePaths=/opt/freya
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
