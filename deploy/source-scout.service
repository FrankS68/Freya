[Unit]
Description=Source Scout - Quellen-Recherche und Portal-Publikation
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/opt/source-scout
EnvironmentFile=/opt/source-scout/.env
ExecStart=/usr/bin/java -Xmx200m -jar /opt/source-scout/target/source-scout-0.1.0.jar
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
